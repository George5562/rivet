{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCP Configuration Reference",
  "description": "Configuration schema for MCP servers and tools",
  "type": "object",
  "required": ["mcpServers"],
  "properties": {
    "mcpServers": {
      "type": "object",
      "description": "Map of MCP server configurations",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "name", "command"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the MCP server"
          },
          "name": {
            "type": "string",
            "description": "Display name for the MCP server"
          },
          "description": {
            "type": "string",
            "description": "Detailed description of the MCP server"
          },
          "command": {
            "type": "string",
            "description": "Command to start the server"
          },
          "args": {
            "type": "array",
            "description": "Command line arguments",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "description": "Environment variables",
            "additionalProperties": {
              "type": "string"
            }
          },
          "tools": {
            "type": "object",
            "description": "Map of tools provided by the MCP server",
            "additionalProperties": {
              "type": "object",
              "required": ["name", "description"],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Display name for the tool"
                },
                "description": {
                  "type": "string",
                  "description": "Detailed description of the tool"
                },
                "inputs": {
                  "type": "object",
                  "description": "Input parameter definitions",
                  "additionalProperties": {
                    "type": "object",
                    "required": ["type", "description"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": ["string", "number", "boolean", "object", "array"],
                        "description": "Parameter type"
                      },
                      "description": {
                        "type": "string",
                        "description": "Parameter description"
                      },
                      "required": {
                        "type": "boolean",
                        "description": "Whether the parameter is required",
                        "default": false
                      },
                      "max": {
                        "type": "number",
                        "description": "Maximum value for number parameters"
                      },
                      "min": {
                        "type": "number",
                        "description": "Minimum value for number parameters"
                      },
                      "items": {
                        "type": "object",
                        "description": "Type definition for array items",
                        "required": ["type"],
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": ["string", "number", "boolean", "object"],
                            "description": "Type of array items"
                          }
                        }
                      }
                    }
                  }
                },
                "outputs": {
                  "type": "object",
                  "description": "Output definitions",
                  "additionalProperties": {
                    "type": "object",
                    "required": ["type", "description"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": ["string", "number", "boolean", "object", "array"],
                        "description": "Output type"
                      },
                      "description": {
                        "type": "string",
                        "description": "Output description"
                      },
                      "items": {
                        "type": "object",
                        "description": "Type definition for array items",
                        "required": ["type"],
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": ["string", "number", "boolean", "object"],
                            "description": "Type of array items"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "mcpServers": {
        "example-server": {
          "id": "example-server",
          "name": "Example Server",
          "description": "Example MCP server configuration",
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-example"],
          "env": {
            "API_KEY": "your-api-key"
          },
          "tools": {
            "example-tool": {
              "name": "Example Tool",
              "description": "Example tool with various parameter types",
              "inputs": {
                "text": {
                  "type": "string",
                  "description": "Text input example",
                  "required": true
                },
                "count": {
                  "type": "number",
                  "description": "Number input with constraints",
                  "min": 0,
                  "max": 100
                },
                "tags": {
                  "type": "array",
                  "description": "Array of strings example",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "outputs": {
                "result": {
                  "type": "object",
                  "description": "Tool execution result"
                },
                "scores": {
                  "type": "array",
                  "description": "Array of numbers example",
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
