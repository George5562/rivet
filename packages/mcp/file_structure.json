{
  "packages": {
    "app-executor": {
      "src": {
        "mcp": {
          "MCPProcessManager.ts": {
            "purpose": "Server process management and lifecycle control",
            "exports": ["MCPProcessManager"],
            "imports": [
              "@ironclad/rivet-mcp-shared/errors",
              "@ironclad/rivet-mcp-shared/security/SecurityManager",
              "@ironclad/rivet-mcp-shared/cache/ToolCache",
              "path",
              "fs/promises"
            ],
            "methods": ["loadConfig", "initialize", "startServer", "stopServer", "discoverTools", "executeRequest"],
            "features": ["Server lifecycle management", "Tool discovery", "Request execution", "Health monitoring"],
            "dependencies": ["SecurityManager", "ToolCache", "MCPError"],
            "status": "complete"
          },
          "types.ts": {
            "purpose": "Type definitions for executor implementation",
            "exports": ["*"],
            "imports": ["@ironclad/rivet-mcp-shared"],
            "dependencies": ["MCPSharedTypes"],
            "status": "complete"
          }
        }
      }
    },
    "mcp-shared": {
      "src": {
        "index.ts": {
          "purpose": "Main package entry point and exports",
          "exports": ["*"],
          "imports": [
            "./types.js",
            "./errors.js",
            "./error-handling.js",
            "./schema.js",
            "./outputs.js",
            "./retry.js",
            "./state/ServerStateMachine.js"
          ],
          "circular_dependencies": true,
          "status": "needs_review"
        },
        "types": {
          "data.ts": {
            "purpose": "Core data type definitions and validation",
            "exports": ["DataType", "DataValue"],
            "imports": ["@ironclad/rivet-core"],
            "dependencies": ["RivetCore"],
            "status": "complete"
          },
          "index.ts": {
            "purpose": "Type exports aggregation",
            "exports": ["*"],
            "imports": ["./data.js"],
            "circular_dependencies": true,
            "status": "needs_review"
          }
        },
        "errors.ts": {
          "purpose": "Error codes and base error class",
          "exports": ["MCPError", "MCPErrorCode"],
          "imports": [],
          "central_dependency": true,
          "status": "complete"
        },
        "error-handling.ts": {
          "purpose": "Enhanced error handling with recovery strategies",
          "exports": ["ErrorHandler", "createError", "ErrorCategory"],
          "imports": ["./errors.js"],
          "dependencies": ["MCPError"],
          "status": "complete"
        },
        "schema.ts": {
          "purpose": "Schema validation and type mapping",
          "exports": ["validateInputSchema", "mapSchemaTypeToRivet"],
          "imports": ["@ironclad/rivet-core", "./errors.js"],
          "dependencies": ["RivetCore", "MCPError"],
          "status": "complete"
        }
      }
    },
    "mcp": {
      "src": {
        "browser": {
          "MCPNode.ts": {
            "purpose": "Core MCP node implementation",
            "exports": ["MCPNode", "MCPNodeImpl"],
            "imports": [
              "@ironclad/rivet-core",
              "@ironclad/rivet-mcp-shared",
              "./MCPBrowserClient.js",
              "./ResourceManager.js"
            ],
            "dependencies": ["ProcessContext", "NodeImpl", "MCPSharedTypes", "MCPError"],
            "status": "complete"
          },
          "MCPBrowserClient.ts": {
            "purpose": "Browser-side MCP client implementation",
            "exports": ["MCPBrowserClient"],
            "imports": ["@tauri-apps/api/tauri", "event-target-shim", "@ironclad/rivet-mcp-shared"],
            "dependencies": ["MCPSharedTypes", "ResourceManager"],
            "status": "complete"
          }
        },
        "cache": {
          "PackageCache.ts": {
            "purpose": "Package-level caching implementation",
            "exports": ["PackageCache"],
            "imports": ["lru-cache", "@ironclad/rivet-mcp-shared", "path", "os", "fs/promises"],
            "dependencies": ["MCPError"],
            "status": "complete"
          }
        }
      }
    }
  }
}
