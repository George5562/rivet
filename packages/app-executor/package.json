{
  "name": "@ironclad/rivet-app-executor",
  "license": "MIT",
  "repository": "https://github.com/ironclad/rivet",
  "version": "1.0.1",
  "bin": "./bin/executor-bundle.cjs",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "yarn workspace @ironclad/rivet-mcp-shared build && tsc && tsx scripts/build-executor.mts --skip-native",
    "build:executor": "tsx scripts/build-executor.mts --skip-native",
    "build:ts": "yarn workspace @ironclad/rivet-mcp-shared build && tsc",
    "build:all": "yarn workspaces foreach -ptv run build",
    "build:dev": "yarn workspace @ironclad/rivet-mcp-shared build && yarn workspace @ironclad/rivet-app-executor build && yarn workspace @ironclad/rivet-core build",
    "dev": "tsx watch --inspect=9228 --experimental-network-imports bin/executor.mts",
    "start": "yarn build && node --experimental-network-imports bin/executor-bundle.cjs",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx,.mts bin"
  },
  "devDependencies": {
    "@ironclad/rivet-core": "workspace:^",
    "@ironclad/rivet-node": "workspace:^",
    "@swc/core": "^1.3.94",
    "@types/node": "^20.0.0",
    "@types/yargs": "^17.0.29",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "appdata-path": "^1.0.0",
    "chalk": "^5.3.0",
    "esbuild": "0.19.5",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint-config-standard-with-typescript": "^39.1.1",
    "eslint-plugin-import": "npm:eslint-plugin-i@latest",
    "eslint-plugin-n": "^16.2.0",
    "eslint-plugin-promise": "^6.1.1",
    "execa": "^8.0.1",
    "pkg": "^5.8.1",
    "tsx": "^4.6.2",
    "type-fest": "^4.5.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@ironclad/rivet-mcp-shared": "workspace:*",
    "ts-pattern": "^5.0.5",
    "yargs": "^17.7.2"
  },
  "volta": {
    "node": "20.4.0"
  }
}
